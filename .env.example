# Anthropic — server-side only, never expose to the browser
# Proveedor de LLM: auto (detecta por las keys presentes) | gemini | anthropic | ninguno
LLM_PROVIDER=auto

# Opcion gratuita: https://aistudio.google.com/apikey (sin tarjeta, 1.500 req/dia)
GEMINI_API_KEY=

# Opcion de pago: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelos (ver README para el desglose de costos)
# Se autoajustan segun el proveedor; descomentar solo para forzar
# MODEL_EXTRACT=gemini-2.5-flash-lite
# MODEL_COMPOSE=gemini-2.5-flash

# Webhook de WhatsApp Cloud API (se genera al desplegar)
WHATSAPP_VERIFY_TOKEN=autocrm-demo-verify-1a2b3c

# Limites del demo (endpoint publico)
MAX_HISTORY_TURNS=12
MAX_MESSAGE_CHARS=500
